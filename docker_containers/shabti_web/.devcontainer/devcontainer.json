{
	"name": "Shabti Web",
	"dockerComposeFile": "../../../shabti_configurator/docker_compose/docker-compose-dev.yml",
	"service": "shabti-web",
	// Configure tool-specific properties.
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"ms-python.debugpy",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.vscode-python-envs"
			]
		}
	},
	"shutdownAction": "stopCompose",
	"workspaceFolder": "/app/",
	// the build uses uv sync --locked, so the lockfiles have to be up to date before it runs
	"initializeCommand": "docker compose -f ../docker-compose-uv-lock.yml run --rm uv-lock"
}
